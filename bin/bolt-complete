#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $_composer_autoload_path ?? dirname(__DIR__).'/vendor/autoload.php';
if (! is_string($autoload) || ! is_file($autoload)) {
    exit(0);
}

require $autoload;

$arguments = array_slice($_SERVER['argv'] ?? [], 1);
$words = array_slice($arguments, 2);

if (basename((string) ($words[0] ?? '')) === 'bolt') {
    $words[0] = 'tempest';
} elseif (basename((string) ($words[0] ?? '')) === 'php' && basename((string) ($words[1] ?? '')) === 'bolt') {
    $words[1] = 'tempest';
} else {
    exit(0);
}

// CompletionApplication owns metadata parsing and suggestion generation. Its
// invocation normalizer is intentionally Tempest-specific, so only its private
// executable marker is translated here; user-facing scripts and output are Bolt.
(new Tempest\Console\Completion\CompletionApplication)->run([
    ...array_slice($arguments, 0, 2),
    ...$words,
]);
