<?php

declare(strict_types=1);

namespace App\Listeners;

use Thunder\Bolt\Attributes\Action;
use Thunder\Bolt\Attributes\Event;
use Thunder\Bolt\Attributes\SlashCommand;
use Thunder\Bolt\Attributes\View;
use Thunder\Bolt\BlockKit\Actions;
use Thunder\Bolt\BlockKit\Button;
use Thunder\Bolt\BlockKit\Input;
use Thunder\Bolt\BlockKit\PlainTextInput;
use Thunder\Bolt\BlockKit\Section;
use Thunder\Bolt\Payloads\Action as SlackAction;
use Thunder\Bolt\Payloads\Events\AppHomeOpened;
use Thunder\Bolt\Payloads\SlashCommand as SlackCommand;
use Thunder\Bolt\Payloads\View as SlackView;
use Thunder\Bolt\Responses\ActionResponse;
use Thunder\Bolt\Responses\CommandResponse;
use Thunder\Bolt\Responses\ViewResponse;
use Thunder\Bolt\Views\Home;
use Thunder\Bolt\Views\Modal;
use Thunder\Bolt\WebApi\Client;
use Thunder\Bolt\WebApi\Requests\ViewRequest;

final readonly class InteractiveApp
{
    #[SlashCommand('/bolt')]
    public function command(SlackCommand $command, Client $client): CommandResponse
    {
        $client
            ->views()
            ->open(ViewRequest::open(
                $command->triggerId
                ?? $command->raw['trigger_id']
                ?? throw new \InvalidArgumentException('A trigger is required.'),
                self::form(),
            ));

        return CommandResponse::ephemeral('The starter form is open.');
    }

    #[Event('app_home_opened')]
    public function home(AppHomeOpened $event, Client $client): void
    {
        if ($event->tab !== null && $event->tab !== 'home') {
            return;
        }
        $client
            ->views()
            ->publish(ViewRequest::publish(
                $event->userId ?? throw new \InvalidArgumentException('A user is required.'),
                Home::make(
                    Section::markdown('Welcome to your Thunder Bolt app.'),
                    Actions::make(Button::make('Open form', 'starter_open')),
                ),
            ));
    }

    #[Action('starter_open')]
    public function open(SlackAction $action, Client $client): ActionResponse
    {
        $client
            ->views()
            ->open(ViewRequest::open(
                $action->triggerId ?? throw new \InvalidArgumentException('A trigger is required.'),
                self::form(),
            ));

        return ActionResponse::empty();
    }

    #[View('starter_form')]
    public function submit(SlackView $view): ViewResponse
    {
        $name = trim($view->form()->get('name', 'name')?->text() ?? '');
        if ($name === '') {
            return ViewResponse::errors(['name' => 'Enter a name.']);
        }
        if (mb_strlen($name) > 100) {
            return ViewResponse::errors(['name' => 'Use at most 100 characters.']);
        }
        return ViewResponse::update(Modal::make(
            'Received',
            Section::text('Thanks, ' . $name . '. Your form was received.'),
        )->close('Done'));
    }

    private static function form(): Modal
    {
        return Modal::make(
            'Thunder Bolt',
            Input::make('Your name', PlainTextInput::make('name')->length(max: 100))->id('name'),
        )
            ->callbackId('starter_form')
            ->submit('Send')
            ->close('Cancel');
    }
}
