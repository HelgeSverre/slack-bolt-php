{
    "name": "thunder/bolt",
    "description": "A PHP-native Slack application framework built on Tempest.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "amphp/amp": "^3.1",
        "amphp/http-client": "^5.3",
        "amphp/websocket-client": "^2.0",
        "guzzlehttp/guzzle": "^7.8.2",
        "guzzlehttp/psr7": "^2.6",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/log": "^3.0",
        "revolt/event-loop": "^1.0",
        "tempest/framework": "^3.20.0"
    },
    "require-dev": {
        "carthage-software/mago": "1.50.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {"psr-4": {"Thunder\\Bolt\\": "src/"}},
    "autoload-dev": {"psr-4": {"Thunder\\Bolt\\Tests\\": "tests/", "App\\": "examples/hello-bolt/app/"}},
    "bin": ["bin/bolt", "bin/bolt-complete"],
    "extra": {"branch-alias": {"dev-main": "0.2.x-dev"}},
    "scripts": {
        "test": "@php vendor/bin/phpunit --exclude-group live",
        "test:live": "@php vendor/bin/phpunit tests/Live",
        "test:project": "@php scripts/smoke-project.php",
        "analyse": "@php vendor/bin/mago analyze",
        "lint": "@php vendor/bin/mago lint",
        "format": "@php vendor/bin/mago format",
        "format:check": "@php vendor/bin/mago format --check"
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
