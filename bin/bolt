#!/usr/bin/env php
<?php

declare(strict_types=1);

if (PHP_VERSION_ID < 80500) {
    fwrite(STDERR, "Thunder Bolt requires PHP 8.5 or newer.\n");
    exit(1);
}

require dirname(__DIR__) . '/src/Console/BoltCli.php';

exit(\Thunder\Bolt\Console\BoltCli::run(
    array_slice($_SERVER['argv'] ?? [], 1),
    dirname(__DIR__),
    is_string($_composer_autoload_path ?? null) ? $_composer_autoload_path : null,
));
