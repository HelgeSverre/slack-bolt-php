SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_USER_ID=
SLACK_IGNORE_SELF=true

# Optional Socket Mode. An app-level xapp token is required only for `bolt socket:serve`.
SLACK_APP_TOKEN=

# Playground: a separate worker handles slow demo jobs after Slack is acknowledged.
# Terminal is a real shell on this host. Only these Slack user IDs can open/type.
SLACK_TERMINAL_ALLOWED_USERS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
SLACK_WORK_OBJECT_BASE_URL=https://example.com/thunder-bolt/work-items

# Optional multi-workspace OAuth. Set all three to enable.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=
SLACK_BOT_SCOPES=app_mentions:read,chat:write,commands
SLACK_USER_SCOPES=
SLACK_INSTALLATION_STORE_PATH=

# Context: file (default), sqlite, memory, or disabled.
SLACK_CONTEXT_STORE=file
# File directory or SQLite database path; default storage stays outside public/.
SLACK_CONTEXT_STORE_PATH=
