{
    "name": "acme/hello-bolt",
    "description": "A minimal Thunder Bolt application with mention and slash-command listeners.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "thunder/bolt": "0.2.x-dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "thunder/bolt": "0.2.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
