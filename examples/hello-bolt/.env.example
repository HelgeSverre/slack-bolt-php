SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_USER_ID=
SLACK_IGNORE_SELF=true

# Optional multi-workspace OAuth. Set all three to enable.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=
SLACK_BOT_SCOPES=app_mentions:read,chat:write,commands
SLACK_USER_SCOPES=
SLACK_INSTALLATION_STORE_PATH=

# Context: file (default), sqlite, memory, or disabled.
SLACK_CONTEXT_STORE=file
# File directory or SQLite database path; default storage stays outside public/.
SLACK_CONTEXT_STORE_PATH=
